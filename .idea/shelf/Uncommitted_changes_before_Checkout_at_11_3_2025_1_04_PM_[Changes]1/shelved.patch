+            self.root,
+            text="▶ Iniciar Juego",
+            font=("Arial", 16, "bold"),
+            bg="#00cc66",
+            fg="white",
+            width=18,
+            height=2,
+            command=self.iniciar_juego
+        )
+        btn_iniciar.pack(pady=15)
+
+        btn_resultados = tk.Button(
+            self.root,
